{
  "schemaVersion": 1,
  "id": "hide-codex-tool-hook-rows",
  "name": "Hide Codex tool hook rows",
  "description": "Keep PreToolUse and PostToolUse hooks running while hiding their timeline rows in the Codex VS Code webview.",
  "extension": {
    "id": "openai.chatgpt",
    "directoryPrefix": "openai.chatgpt-"
  },
  "operations": [
    {
      "fileGlob": "webview/assets/index-*.js",
      "syntax": "javascript",
      "requiredContains": [
        "localConversation.hookItem.summary.ariaLabel",
        "localConversation.hookItem.eventName.preToolUse",
        "localConversation.hookItem.eventName.postToolUse"
      ],
      "alreadyAppliedMarker": "/* vscode-mods:hide-codex-tool-hook-rows */",
      "regex": {
        "pattern": "(function\\s+[$A-Za-z_][$\\w]*\\(([$A-Za-z_][$\\w]*)\\)\\{let\\s+[$A-Za-z_][$\\w]*=\\(0,[$A-Za-z_][$\\w]*\\.c\\)\\(\\d+\\),\\{item:([$A-Za-z_][$\\w]*)\\}=\\2,[$A-Za-z_][$\\w]*=[$A-Za-z_][$\\w]*\\(\\),\\[[$A-Za-z_][$\\w]*,[$A-Za-z_][$\\w]*\\]=\\(0,[$A-Za-z_][$\\w]*\\.useState\\)\\(!1\\),[$A-Za-z_][$\\w,]*;)",
        "flags": "",
        "expectedMatches": 1,
        "replacement": "$1/* vscode-mods:hide-codex-tool-hook-rows */if($3.run.eventName===`preToolUse`||$3.run.eventName===`postToolUse`)return null;"
      }
    },
    {
      "fileGlob": "webview/assets/index-*.js",
      "syntax": "javascript",
      "requiredContains": [
        "localConversation.hookItem.summary.ariaLabel",
        "localConversation.hookItem.eventName.preToolUse",
        "localConversation.hookItem.eventName.postToolUse"
      ],
      "alreadyAppliedMarker": "/* vscode-mods:hide-codex-tool-hook-unit */",
      "regex": {
        "pattern": "(([$A-Za-z_][$\\w]*)\\.type===`hook`\\?)(\\(0,[$A-Za-z_][$\\w]*\\.jsx\\)\\(([$A-Za-z_][$\\w]*),\\{item:\\2\\}\\))(:\\2\\.type===`reasoning`\\?null)",
        "flags": "",
        "expectedMatches": 1,
        "replacement": "$1/* vscode-mods:hide-codex-tool-hook-unit */($2.run.eventName===`preToolUse`||$2.run.eventName===`postToolUse`?null:$3)$5"
      }
    },
    {
      "fileGlob": "webview/assets/index-*.js",
      "syntax": "javascript",
      "requiredContains": [
        "localConversation.hookItem.summary.ariaLabel",
        "localConversation.hookItem.eventName.preToolUse",
        "localConversation.hookItem.eventName.postToolUse"
      ],
      "alreadyAppliedMarker": "/* vscode-mods:hide-codex-pre-user-hook-row */",
      "regex": {
        "pattern": "(for\\(let\\s+([$A-Za-z_][$\\w]*)\\s+of\\s+[$A-Za-z_][$\\w]*\\))(([$A-Za-z_][$\\w]*)\\(`pre-user-\\$\\{\\2\\.id\\}`,\\(0,[$A-Za-z_][$\\w]*\\.jsx\\)\\([$A-Za-z_][$\\w]*,\\{item:\\2\\}\\)\\);)",
        "flags": "",
        "expectedMatches": 1,
        "replacement": "$1{/* vscode-mods:hide-codex-pre-user-hook-row */if($2.run.eventName===`preToolUse`||$2.run.eventName===`postToolUse`)continue;$3}"
      }
    },
    {
      "fileGlob": "webview/assets/index-*.js",
      "syntax": "javascript",
      "requiredContains": [
        "localConversation.hookItem.summary.ariaLabel",
        "localConversation.hookItem.eventName.preToolUse",
        "localConversation.hookItem.eventName.postToolUse"
      ],
      "alreadyAppliedMarker": "/* vscode-mods:hide-codex-post-assistant-hook-row */",
      "regex": {
        "pattern": "(([$A-Za-z_][$\\w]*)\\.type===`hook`\\?)(\\(0,[$A-Za-z_][$\\w]*\\.jsx\\)\\(([$A-Za-z_][$\\w]*),\\{item:\\2\\}\\))(:[$A-Za-z_][$\\w]*\\(\\{item:\\2,conversationId:)",
        "flags": "",
        "expectedMatches": 1,
        "replacement": "$1/* vscode-mods:hide-codex-post-assistant-hook-row */($2.run.eventName===`preToolUse`||$2.run.eventName===`postToolUse`?null:$3)$5"
      }
    }
  ]
}
